<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:minWidth="320dp">

    <!-- Search bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/et_hf_search"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="Search GGUF models (e.g. qwen, llama)"
            android:background="@drawable/bg_input_box_background"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textSize="14sp"
            android:imeOptions="actionSearch"
            android:inputType="text" />

        <Button
            android:id="@+id/btn_hf_search_go"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_rounded_border"
            android:text="Search"
            android:textAllCaps="false"
            android:textColor="@color/font_primary" />
    </LinearLayout>

    <!-- Status text -->
    <TextView
        android:id="@+id/tv_hf_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Enter a keyword to search Hugging Face"
        android:textColor="@color/font_tertiary"
        android:textSize="12sp" />

    <!-- Model results list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_hf_results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

    <!-- File selection area (hidden until a repo is picked) -->
    <LinearLayout
        android:id="@+id/ll_hf_file_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/tv_hf_selected_repo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Selected repo:"
            android:textColor="@color/font_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/sp_hf_files"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Vision projector (mmproj)"
            android:textColor="@color/font_primary"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/sp_hf_mmproj"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_hf_add_model"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/btn_rounded_black_bg_18"
                android:text="Add &amp; Download"
                android:textAllCaps="false"
                android:textColor="@color/surface" />

            <Button
                android:id="@+id/btn_hf_back"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_rounded_border"
                android:text="Back"
                android:textAllCaps="false"
                android:textColor="@color/font_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Connection settings, applied from the next download onwards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <CheckBox
            android:id="@+id/cb_hf_mirror"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use hf-mirror.com (fallback for restricted networks)"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/et_hf_token"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_box_background"
            android:hint="HF access token (gated repos only)"
            android:imeOptions="actionDone"
            android:inputType="textNoSuggestions"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
